{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "graphify-mcp",
        "--graph",
        "graphify-out/graph.json"
      ],
      "enabled": true,
      "environment": {
        "PATH": "{env:PATH}"
      }
    }
  }
}